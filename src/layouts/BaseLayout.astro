---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SmsOptIn from '../components/site/SmsOptIn.astro';
import {
  SITE_URL,
  SITE_NAME,
  ORG_NAME,
  DEFAULT_OG,
  LOGO,
  PHONE_TEL,
  EMAIL,
} from '../data/site';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  dataPage?: string;
  isArticle?: boolean;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalPath = '',
  dataPage = 'Home',
  isArticle = false,
  image = DEFAULT_OG,
  noindex = false,
} = Astro.props;

const canonical = canonicalPath ? `${SITE_URL}/${canonicalPath}` : `${SITE_URL}/`;

const orgJson = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: ORG_NAME,
  url: SITE_URL,
  logo: LOGO,
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: PHONE_TEL,
    contactType: 'customer service',
    email: EMAIL,
    areaServed: 'US',
    availableLanguage: 'English',
  },
  sameAs: [
    'https://www.facebook.com/CarWashManagementLLC',
    'https://www.linkedin.com/company/carwashmgmt/',
    'https://www.youtube.com/@CarWashManagementLLC',
    'https://www.instagram.com/carwashmgmt',
  ],
};

const websiteJson = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  url: SITE_URL,
  publisher: { '@type': 'Organization', name: ORG_NAME },
};

const articleJson = isArticle
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title.replace(/ \| Car Wash Services$/, ''),
      description,
      image,
      author: { '@type': 'Organization', name: SITE_NAME },
      publisher: {
        '@type': 'Organization',
        name: ORG_NAME,
        logo: { '@type': 'ImageObject', url: LOGO },
      },
      mainEntityOfPage: canonical,
    }
  : null;

const schemas = [orgJson, websiteJson, articleJson].filter(Boolean);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Outfit:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/assets/site.css" />
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js" is:inline></script>
    <meta property="og:type" content={isArticle ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {
      schemas.map((s) => (
        <script type="application/ld+json" set:html={JSON.stringify(s)} />
      ))
    }
  </head>
  <body data-page={dataPage}>
    <Header currentPage={dataPage} />
    {!noindex && <SmsOptIn variant="banner" />}
    <main>
      <slot />
    </main>
    <Footer />
    <script src="/assets/site.js" is:inline></script>
  </body>
</html>
