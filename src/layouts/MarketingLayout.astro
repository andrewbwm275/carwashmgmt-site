---
import SiteLayout from './SiteLayout.astro';
import { SITE_URL } from '../data/site';

interface Props {
  title: string;
  description: string;
  path: string;
  pageKey: string;
  badge?: string;
  headline: string;
  subhead?: string;
  heroImage?: string;
  darkHero?: boolean;
  ctaHref?: string;
  ctaLabel?: string;
}

const {
  title,
  description,
  path,
  pageKey,
  badge,
  headline,
  subhead,
  heroImage,
  darkHero = true,
  ctaHref = '/book-a-call',
  ctaLabel = 'Book a consult',
} = Astro.props;
---

<SiteLayout title={title} description={description} canonical={`${SITE_URL}${path}`} pageKey={pageKey}>
  <section class="cwm-mkt-hero">
    {heroImage ? (
      <div class="cwm-mkt-hero-bg">
        <img src={heroImage} alt="" />
      </div>
    ) : darkHero ? (
      <div class="cwm-mkt-hero-solid"></div>
    ) : null}
    <div class="cwm-mkt-hero-content">
      {badge && <span class="cwm-eyebrow">{badge}</span>}
      <h1>{headline}</h1>
      {subhead && <p>{subhead}</p>}
      <a href={ctaHref} class="cwm-btn-primary">{ctaLabel}</a>
    </div>
  </section>
  <slot />
</SiteLayout>
