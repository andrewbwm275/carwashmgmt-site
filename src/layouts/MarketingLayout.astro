---
/**
 * Shared marketing page shell with hero + content slot.
 */
import SiteLayout from './SiteLayout.astro';
import { SITE_URL } from '../data/site';

interface Props {
  title: string;
  description: string;
  path: string;
  pageKey: string;
  badge?: string;
  headline: string;
  subhead?: string;
  heroImage?: string;
  darkHero?: boolean;
  ctaHref?: string;
  ctaLabel?: string;
}

const {
  title,
  description,
  path,
  pageKey,
  badge,
  headline,
  subhead,
  heroImage,
  darkHero = true,
  ctaHref = '/book-a-call',
  ctaLabel = 'Book a Free Strategy Call →',
} = Astro.props;
---

<SiteLayout title={title} description={description} canonical={`${SITE_URL}${path}`} pageKey={pageKey}>
  <section class={`cwm-mkt-hero ${darkHero ? '' : 'cwm-mkt-hero--light'}`} style={darkHero ? undefined : 'padding:80px 24px;color:#0f172a;background:#fff'}>
    {heroImage ? (
      <div class="cwm-mkt-hero-bg">
        <img src={heroImage} alt="" />
      </div>
    ) : darkHero ? (
      <div class="cwm-mkt-hero-solid"></div>
    ) : null}
    <div class="cwm-mkt-hero-content">
      {badge && (
        <span class="cwm-eyebrow" style={darkHero ? undefined : ''}>{badge}</span>
      )}
      <h1>{headline}</h1>
      {subhead && <p style={darkHero ? undefined : 'color:#64748b'}>{subhead}</p>}
      <a href={ctaHref} class="cwm-btn-primary cwm-btn-lg">{ctaLabel}</a>
    </div>
  </section>
  <slot />
</SiteLayout>
