---
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import StickyCta from '../components/site/StickyCta.astro';
import SmsOptIn from '../components/site/SmsOptIn.astro';
import { SITE_NAME, DEFAULT_OG, SITE_URL } from '../data/site';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  pageKey?: string;
  ogImage?: string;
  hideSticky?: boolean;
}

const {
  title,
  description = 'Car Wash Management — consulting, equipment, chemistry, and preventive maintenance for car wash operators.',
  canonical = SITE_URL + '/',
  pageKey = '',
  ogImage = DEFAULT_OG,
  hideSticky = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/assets/live.css" />
    <link rel="stylesheet" href="/assets/site.css" />
  </head>
  <body data-page={pageKey} class="min-h-screen flex flex-col bg-white text-slate-900">
    <Header current={pageKey} />
    {pageKey === 'home' || pageKey === 'sms' ? <SmsOptIn variant="full" /> : <SmsOptIn variant="banner" />}
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    {!hideSticky && <StickyCta />}
    <script src="/assets/site-interact.js" is:inline></script>
  </body>
</html>
