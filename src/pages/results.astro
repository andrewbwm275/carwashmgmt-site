---
import MarketingLayout from '../layouts/MarketingLayout.astro';
---

<MarketingLayout
  title="Results | Car Wash Management"
  description="Real results from car wash operators—lower costs, less downtime, better margins."
  path="/results"
  pageKey="results"
  badge="Case Study"
  headline="Results That Impact Your Bottom Line"
  subhead="Operators who needed better performance, lower costs, and reliable systems."
>
  <section class="max-w-5xl mx-auto px-6 py-16">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
      {[
        { v: '150+', l: 'Washes Optimized' },
        { v: '20–40%', l: 'Chemical Cost Reduction' },
        { v: 'Up to 70%', l: 'Downtime Reduction' },
        { v: '$1M+', l: 'Estimated Client Savings' },
      ].map((s) => (
        <div class="text-center rounded-2xl border border-slate-200 p-6">
          <div class="text-3xl font-black text-[#0779ef] mb-1">{s.v}</div>
          <div class="text-sm text-slate-500">{s.l}</div>
        </div>
      ))}
    </div>
    <div class="bg-white rounded-2xl border border-slate-200 p-8 mb-8">
      <p class="text-lg text-slate-700 leading-relaxed mb-4">"CWM completely transformed our operation. We cut water costs by 45% and increased our throughput by 30%. The ROI was immediate and the ongoing support is top-notch."</p>
      <p class="text-sm text-slate-500">Multi-site operator</p>
    </div>
    <div class="text-center">
      <a href="/testimonials" class="text-[#0779ef] font-semibold hover:underline mr-6">Read testimonials →</a>
      <a href="/book-a-call" class="inline-flex bg-[#0779ef] text-white font-bold px-6 py-3 rounded-xl">Get Similar Results</a>
    </div>
  </section>
</MarketingLayout>
