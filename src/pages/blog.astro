---
import SiteLayout from '../layouts/SiteLayout.astro';
import { SITE_URL, BLOG_POSTS } from '../data/site';
---

<SiteLayout
  title="Blog | Car Wash Management"
  description="Car wash operations insights—chemistry costs, downtime, profit leaks, and maintenance."
  canonical={`${SITE_URL}/blog`}
  pageKey="blog"
>
  <section class="max-w-5xl mx-auto px-6 py-16">
    <div class="text-center mb-12">
      <h1 class="text-4xl font-black text-slate-950 mb-3">Blog</h1>
      <p class="text-slate-500">Practical insights for operators who care about profit and uptime.</p>
    </div>
    <div class="grid md:grid-cols-2 gap-6">
      {BLOG_POSTS.map((p) => (
        <a href={`/blog/${p.slug}`} class="block rounded-2xl border border-slate-200 p-6 hover:border-[#0779ef]/40 hover:shadow-lg transition-all">
          <h2 class="text-xl font-black text-slate-900 mb-2">{p.title}</h2>
          <p class="text-sm text-slate-600">{p.description}</p>
          <span class="inline-block mt-4 text-sm font-semibold text-[#0779ef]">Read more →</span>
        </a>
      ))}
    </div>
  </section>
</SiteLayout>
