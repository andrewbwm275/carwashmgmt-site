---
import SiteLayout from '../layouts/SiteLayout.astro';
import { SITE_URL } from '../data/site';
---

<SiteLayout title="Resources | Car Wash Management" description="Guides and tools for car wash operators." canonical={`${SITE_URL}/resources`} pageKey="resources">
  <section class="max-w-4xl mx-auto px-6 py-16">
    <h1 class="text-4xl font-black text-slate-950 mb-8">Resources</h1>
    <div class="grid md:grid-cols-2 gap-6">
      <a href="/calculator" class="rounded-2xl border border-slate-200 p-6 hover:border-[#0779ef]/40 transition-all">
        <h2 class="font-black text-lg mb-2">Nano Bubble ROI Calculator</h2>
        <p class="text-sm text-slate-600">Estimate monthly and annual savings.</p>
      </a>
      <a href="/blog" class="rounded-2xl border border-slate-200 p-6 hover:border-[#0779ef]/40 transition-all">
        <h2 class="font-black text-lg mb-2">Blog &amp; Guides</h2>
        <p class="text-sm text-slate-600">Cost leaks, downtime, chemistry, and PM.</p>
      </a>
      <a href="/book-a-call" class="rounded-2xl border border-slate-200 p-6 hover:border-[#0779ef]/40 transition-all">
        <h2 class="font-black text-lg mb-2">Free Strategy Call</h2>
        <p class="text-sm text-slate-600">Get a site-specific action plan.</p>
      </a>
      <a href="/chemistry" class="rounded-2xl border border-slate-200 p-6 hover:border-[#0779ef]/40 transition-all">
        <h2 class="font-black text-lg mb-2">Chemistry Catalog</h2>
        <p class="text-sm text-slate-600">Browse products and request a quote.</p>
      </a>
    </div>
  </section>
</SiteLayout>
