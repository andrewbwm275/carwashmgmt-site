---
import MarketingLayout from '../layouts/MarketingLayout.astro';
---

<MarketingLayout
  title="Testimonials | Car Wash Management"
  description="Car Wash Management does not invent operator reviews."
  path="/testimonials"
  pageKey="testimonials"
  badge="Operators"
  headline="No invented reviews."
  subhead="This brand does not publish fake names, fake logos, or made-up ROI quotes. The catalog is real."
  ctaHref="/submit-testimonial"
  ctaLabel="Submit a real quote"
>
  <section class="cwm-legal-page">
    <div class="cwm-honest">
      <p>
        If you run a wash that uses Car Wash Management chemistry or PM and want a named quote on this site, send it.
        Until then, this page stays empty on purpose.
      </p>
    </div>
  </section>
</MarketingLayout>
