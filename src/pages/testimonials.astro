---
import MarketingLayout from '../layouts/MarketingLayout.astro';
---

<MarketingLayout
  title="Testimonials | Car Wash Management"
  description="Car Wash Management does not invent operator reviews. Submit a real quote if you run a CWM site."
  path="/testimonials"
  pageKey="testimonials"
  badge="Operators"
  headline="No invented reviews."
  subhead="This brand does not publish fake names or made-up ROI quotes. The catalog is real. Testimonials wait for operators who actually ran the chemistry."
>
  <section class="cwm-legal-page">
    <div class="cwm-honest">
      <p>
        If you operate a wash that uses Car Wash Management chemistry or PM and want a quote on this page, send it.
        We will not attribute numbers to people who did not say them.
      </p>
      <p>
        <a href="/submit-testimonial">Submit a real testimonial →</a>
      </p>
    </div>
  </section>
</MarketingLayout>
