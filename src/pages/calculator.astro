---
import SiteLayout from '../layouts/SiteLayout.astro';
import { SITE_URL } from '../data/site';

const heroImg =
  'https://media.base44.com/images/public/699f163455fdaf19c59586b8/91d199782_pexels-fotios-photos-14513938.jpg';
---

<SiteLayout
  title="Nano Bubble ROI Calculator | Car Wash Management"
  description="Calculate your car wash savings with Nano Bubble technology. Free interactive ROI tool."
  canonical={`${SITE_URL}/calculator`}
  pageKey="calculator"
  hideSticky={true}
>
  <section class="relative py-16 px-6 overflow-hidden" style="min-height: 280px">
    <div class="absolute inset-0">
      <img src={heroImg} alt="" class="w-full h-full object-cover" />
      <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(7,121,239,0.75) 0%, rgba(10,20,50,0.82) 100%)"></div>
    </div>
    <div class="relative z-10 max-w-3xl mx-auto text-center text-white">
      <span class="inline-block text-xs font-bold uppercase tracking-widest mb-4 px-4 py-1.5 rounded-full border border-white/60">ROI &amp; Profit Tools</span>
      <h1 class="text-4xl md:text-5xl font-black uppercase mb-4">Nano Bubble ROI Calculator</h1>
      <p class="text-white/80 text-lg max-w-xl mx-auto mb-4">See exactly how much you can save by switching to Nano Bubble technology.</p>
      <div class="mx-auto w-16 h-1 rounded-full bg-white/70"></div>
    </div>
  </section>

  <section class="py-10 px-6 bg-white">
    <div class="max-w-3xl mx-auto">
      <div class="relative w-full rounded-xl overflow-hidden shadow-lg" style="padding-bottom: 56.25%">
        <iframe
          class="absolute inset-0 w-full h-full"
          src="https://www.youtube.com/embed/2FBKYZ_iDOo"
          title="Nano Bubble Technology"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>

  <section class="py-8 px-6 bg-white border-b border-slate-100">
    <div class="max-w-xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div data-step-indicator="1" class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold bg-blue-600 text-white">1</div>
        <span data-step-label="1" class="text-sm font-medium hidden sm:inline text-slate-900">Your Wash</span>
      </div>
      <div class="w-12 sm:w-24 h-0.5 mx-2 bg-slate-200"></div>
      <div class="flex items-center gap-2">
        <div data-step-indicator="2" class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold bg-slate-100 text-slate-400">2</div>
        <span data-step-label="2" class="text-sm font-medium hidden sm:inline text-slate-400">Your Info</span>
      </div>
      <div class="w-12 sm:w-24 h-0.5 mx-2 bg-slate-200"></div>
      <div class="flex items-center gap-2">
        <div data-step-indicator="3" class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold bg-slate-100 text-slate-400">3</div>
        <span data-step-label="3" class="text-sm font-medium hidden sm:inline text-slate-400">Results</span>
      </div>
    </div>
  </section>

  <section class="py-12 px-6 bg-slate-50 min-h-[50vh]" data-calculator>
    <div class="max-w-xl mx-auto">
      <!-- Step 1 -->
      <div data-calc-step="1" class="space-y-6 bg-white rounded-2xl border border-slate-200 p-6 md:p-8 shadow-sm">
        <div>
          <h2 class="text-2xl font-bold text-slate-900 mb-1">How much is inefficient water costing you?</h2>
          <p class="text-sm text-slate-500">See exactly how much you can save by switching to Nano Bubble technology. Reduce chemical usage, lower water bills, and cut maintenance costs instantly.</p>
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5">Avg. Monthly Washes *</label>
          <input name="cars_per_month" type="number" value="5000" placeholder="e.g. 10,000" class="w-full h-11 rounded-md border border-slate-200 px-3 text-base" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5">Avg. Monthly Water Bill *</label>
          <input name="water_bill" type="number" value="3500" placeholder="e.g. 3,500" class="w-full h-11 rounded-md border border-slate-200 px-3 text-base" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5">Avg. Monthly Chemical Cost *</label>
          <input name="chemical_spend_monthly" type="number" value="5000" placeholder="e.g. 5,000" class="w-full h-11 rounded-md border border-slate-200 px-3 text-base" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5">Quarterly Pit Cleaning Cost *</label>
          <input name="pit_cleaning" type="number" value="2500" placeholder="e.g. 2500" class="w-full h-11 rounded-md border border-slate-200 px-3 text-base" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1.5">Monthly Maintenance Cost *</label>
          <input name="maintenance_cost" type="number" value="1500" placeholder="e.g. 1500" class="w-full h-11 rounded-md border border-slate-200 px-3 text-base" />
        </div>
        <p class="text-xs text-slate-400">Estimated savings based on industry standard Nano Bubble efficiency.</p>
        <button type="button" data-calc-next class="w-full bg-[#0779ef] hover:bg-blue-600 disabled:opacity-50 disabled:cursor-not-allowed text-white font-bold py-3 rounded-xl transition-colors">
          Calculate Annual ROI
        </button>
      </div>

      <!-- Step 2 -->
      <div data-calc-step="2" hidden class="space-y-6 bg-white rounded-2xl border border-slate-200 p-6 md:p-8 shadow-sm">
        <div>
          <h2 class="text-2xl font-bold text-slate-900 mb-1">Where should we send your results?</h2>
          <p class="text-sm text-slate-500">Enter your details to unlock estimated monthly and annual savings.</p>
        </div>
        <form id="cwm-calc-lead" class="space-y-4">
          <input name="name" required placeholder="Your name" class="w-full h-11 rounded-md border border-slate-200 px-3" />
          <input name="email" type="email" required placeholder="you@company.com" class="w-full h-11 rounded-md border border-slate-200 px-3" />
          <input name="phone" placeholder="Phone (optional)" class="w-full h-11 rounded-md border border-slate-200 px-3" />
          <input name="city_state" placeholder="City, State" class="w-full h-11 rounded-md border border-slate-200 px-3" />
          <div class="flex gap-3">
            <button type="button" data-calc-back class="flex-1 border border-slate-200 font-semibold py-3 rounded-xl">Back</button>
            <button type="submit" class="flex-[2] bg-[#0779ef] text-white font-bold py-3 rounded-xl">Show My Savings</button>
          </div>
        </form>
      </div>

      <!-- Step 3 -->
      <div data-calc-step="3" hidden class="bg-white rounded-2xl border border-slate-200 p-6 md:p-8 shadow-sm">
        <h2 class="text-2xl font-bold text-slate-900 mb-6">Your estimated savings</h2>
        <div data-calc-results></div>
      </div>
    </div>
  </section>
</SiteLayout>
