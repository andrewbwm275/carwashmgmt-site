---
import SiteLayout from '../layouts/SiteLayout.astro';
import { SITE_URL, PHONE, PHONE_TEL, EMAIL, CALENDLY_URL } from '../data/site';
---

<SiteLayout
  title="Contact | Car Wash Management"
  description="Contact Car Wash Management for consulting, chemistry, equipment, and maintenance."
  canonical={`${SITE_URL}/contact`}
  pageKey="contact"
>
  <section class="max-w-5xl mx-auto px-6 py-16 grid lg:grid-cols-2 gap-12">
    <div>
      <h1 class="text-4xl font-black text-slate-950 mb-4">Contact Us</h1>
      <p class="text-slate-600 mb-8">Tell us about your wash—we'll follow up with clear next steps. No pressure.</p>
      <ul class="space-y-3 text-sm text-slate-700 mb-8">
        <li>Call: <a href={`tel:${PHONE_TEL}`} class="hover:text-[#0779ef] font-semibold">{PHONE}</a></li>
        <li>SMS (keyword only): text START to <a href="sms:+16199146819&body=START" class="hover:text-[#0779ef] font-semibold">+1 619-914-6819</a></li>
        <li><a href={`mailto:${EMAIL}`} class="hover:text-[#0779ef] font-semibold">{EMAIL}</a></li>
        <li>Mon–Fri: 8am – 6pm PST</li>
        <li>Serving car washes nationwide</li>
      </ul>
      <a href={CALENDLY_URL} target="_blank" rel="noopener" class="inline-flex bg-[#0779ef] text-white font-bold px-6 py-3 rounded-xl">Book on Calendly</a>
    </div>
    <form data-form="contact" class="bg-white rounded-2xl border border-slate-200 p-6 md:p-8 space-y-4 shadow-sm">
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold mb-1.5">Name *</label>
          <input name="name" required class="w-full px-3 py-2.5 rounded-lg border border-slate-200 text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold mb-1.5">Email *</label>
          <input name="email" type="email" required class="w-full px-3 py-2.5 rounded-lg border border-slate-200 text-sm" />
        </div>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold mb-1.5">Phone</label>
          <input name="phone" class="w-full px-3 py-2.5 rounded-lg border border-slate-200 text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold mb-1.5">Company</label>
          <input name="company_name" class="w-full px-3 py-2.5 rounded-lg border border-slate-200 text-sm" />
        </div>
      </div>
      <div>
        <label class="block text-xs font-semibold mb-1.5">City / State</label>
        <input name="city_state" class="w-full px-3 py-2.5 rounded-lg border border-slate-200 text-sm" />
      </div>
      <div>
        <label class="block text-xs font-semibold mb-1.5">Message</label>
        <textarea name="message" rows="4" class="w-full px-3 py-2.5 rounded-lg border border-slate-200 text-sm"></textarea>
      </div>
      <p class="text-xs text-slate-600 leading-relaxed">
        This form does <strong>not</strong> opt you in to SMS. The only way to receive customer-care texts is to text
        <strong>START</strong> to <a class="text-[#0779ef] underline" href="sms:+16199146819&body=START">+1 619-914-6819</a>.
        Consent is not a condition of purchase. Reply STOP to opt out, HELP for help. Message frequency varies (up to 8
        messages per month plus replies). Message and data rates may apply.
        <a class="text-[#0779ef] underline" href="https://legal.carwashmgmt.com/privacy-policy.html">Privacy Policy</a>
        and
        <a class="text-[#0779ef] underline" href="https://legal.carwashmgmt.com/terms-and-conditions.html">Terms</a>.
        We do not share mobile numbers or SMS consent with third parties or affiliates for marketing.
      </p>
      <button type="submit" class="w-full bg-[#0779ef] text-white font-bold py-3 rounded-xl">Send Message</button>
    </form>
  </section>
</SiteLayout>
