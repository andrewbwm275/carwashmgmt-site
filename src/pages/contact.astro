---
import SiteLayout from '../layouts/SiteLayout.astro';
import { SITE_URL, PHONE, PHONE_TEL, EMAIL, CALENDLY_URL, SMS_DISPLAY, SMS_KEYWORD, SMS_HREF } from '../data/site';
---

<SiteLayout
  title="Contact | Car Wash Management"
  description="Contact Car Wash Management. 7776 Trade Street, San Diego. Text START to +1 619-914-6819 for customer-care SMS."
  canonical={`${SITE_URL}/contact`}
  pageKey="contact"
>
  <section class="cwm-mkt-hero">
    <div class="cwm-mkt-hero-solid"></div>
    <div class="cwm-mkt-hero-content">
      <span class="cwm-eyebrow">Contact</span>
      <h1>Talk like operators.</h1>
      <p>7776 Trade Street, San Diego. Nationwide service. No pitch deck.</p>
    </div>
  </section>

  <section class="cwm-page cwm-page--wide">
    <div class="cwm-contact-grid">
        <div>
          <p class="cwm-mono">Reach</p>
          <ul class="cwm-plain-list">
            <li>Voice <a href={`tel:${PHONE_TEL}`}>{PHONE}</a></li>
            <li>SMS — text <strong>{SMS_KEYWORD}</strong> to <a href={SMS_HREF}>{SMS_DISPLAY}</a></li>
            <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
            <li>Mon–Fri, 8am–6pm Pacific</li>
          </ul>
          <p><a class="cwm-text-link" href={CALENDLY_URL} target="_blank" rel="noopener">Calendly</a></p>
        </div>
        <form data-form="contact" class="cwm-form">
          <div>
            <label class="cwm-label" for="c-name">Name *</label>
            <input id="c-name" class="cwm-input" name="name" required />
          </div>
          <div>
            <label class="cwm-label" for="c-email">Email *</label>
            <input id="c-email" class="cwm-input" name="email" type="email" required />
          </div>
          <div>
            <label class="cwm-label" for="c-phone">Phone</label>
            <input id="c-phone" class="cwm-input" name="phone" />
          </div>
          <div>
            <label class="cwm-label" for="c-msg">What’s broken or what do you want quoted?</label>
            <textarea id="c-msg" class="cwm-input" name="message" rows="5"></textarea>
          </div>
          <button type="submit" class="cwm-btn-primary">Send</button>
        </form>
    </div>
  </section>
</SiteLayout>
