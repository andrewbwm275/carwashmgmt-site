<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting…</title>
    <script is:inline>
      (function () {
        var p = new URLSearchParams(location.search);
        var slug = p.get('slug');
        location.replace(slug ? '/chemical-product/' + encodeURIComponent(slug) : '/chemistry');
      })();
    </script>
    <meta http-equiv="refresh" content="0;url=/chemistry" />
  </head>
  <body>
    <p><a href="/chemistry">Continue to Chemistry</a></p>
  </body>
</html>
