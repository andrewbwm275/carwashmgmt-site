---
import { PHONE, PHONE_TEL, EMAIL, HOURS_FOOTER, SOCIAL } from '../../data/site';
import SmsOptIn from './SmsOptIn.astro';
---

<footer class="cwm-footer">
  <div class="cwm-footer-inner">
    <div class="cwm-footer-brand">
      <div class="cwm-footer-logo">Car Wash <span style="color:var(--cwm-brass)">Management</span></div>
      <p>
        San Diego operator shop: tunnel chemistry, equipment, and preventive maintenance. Quoted by size, not slogans.
      </p>
      <div class="cwm-footer-social">
        <a href={SOCIAL.facebook} aria-label="Facebook" target="_blank" rel="noopener">
          <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12a10 10 0 1 0-11.5 9.9v-7H8v-3h2.5V9.5c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.2c-1.2 0-1.6.8-1.6 1.5V12H17l-.4 3h-2.3v7A10 10 0 0 0 22 12z"/></svg>
        </a>
        <a href={SOCIAL.linkedin} aria-label="LinkedIn" target="_blank" rel="noopener">
          <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M4.98 3.5C4.98 4.88 3.86 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.5 8.5h4V24h-4V8.5zM8.5 8.5h3.8v2.1h.1c.5-1 1.8-2.1 3.8-2.1 4 0 4.8 2.7 4.8 6.1V24h-4v-7.1c0-1.7 0-3.9-2.4-3.9s-2.7 1.8-2.7 3.8V24h-4V8.5z"/></svg>
        </a>
        <a href={SOCIAL.youtube} aria-label="YouTube" target="_blank" rel="noopener">
          <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31.5 31.5 0 0 0 0 12a31.5 31.5 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31.5 31.5 0 0 0 24 12a31.5 31.5 0 0 0-.5-5.8zM9.8 15.5v-7l6.3 3.5-6.3 3.5z"/></svg>
        </a>
        <a href={SOCIAL.instagram} aria-label="Instagram" target="_blank" rel="noopener">
          <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.2c3.2 0 3.6 0 4.9.1 3.3.1 4.8 1.7 4.9 4.9.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 3.2-1.6 4.8-4.9 4.9-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-3.3-.1-4.8-1.7-4.9-4.9C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9C2.4 3.9 4 2.4 7.2 2.3 8.5 2.2 8.9 2.2 12 2.2zm0 1.8c-3.1 0-3.5 0-4.7.1-2.2.1-3.2 1.1-3.3 3.3-.1 1.2-.1 1.6-.1 4.7s0 3.5.1 4.7c.1 2.2 1.1 3.2 3.3 3.3 1.2.1 1.6.1 4.7.1s3.5 0 4.7-.1c2.2-.1 3.2-1.1 3.3-3.3.1-1.2.1-1.6.1-4.7s0-3.5-.1-4.7c-.1-2.2-1.1-3.2-3.3-3.3-1.2-.1-1.6-.1-4.7-.1zm0 3.1a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 8.2a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4zm6.3-8.4a1.2 1.2 0 1 1-2.3 0 1.2 1.2 0 0 1 2.3 0z"/></svg>
        </a>
      </div>
    </div>

    <div>
      <h4>Contact</h4>
      <ul>
        <li><a href={`tel:${PHONE_TEL}`}>Call {PHONE}</a></li>
        <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
        <li>{HOURS_FOOTER}</li>
        <li>Serving car washes nationwide</li>
        <li><a href="/sms">Text START to +1 619-914-6819</a></li>
      </ul>
    </div>

    <div>
      <h4>Quick Links</h4>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/services">Services</a></li>
        <li><a href="/solutions">Solutions</a></li>
        <li><a href="/equipment">Equipment</a></li>
        <li><a href="/chemistry">Chemistry</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/sms">SMS program</a></li>
        <li><a href="https://legal.carwashmgmt.com/privacy-policy.html">Privacy (A2P)</a></li>
        <li><a href="https://legal.carwashmgmt.com/terms-and-conditions.html">Terms (A2P)</a></li>
        <li><a href="/privacy-policy">Privacy Policy</a></li>
        <li><a href="/terms-and-conditions">Terms &amp; Conditions</a></li>
      </ul>
    </div>
  </div>

  <div class="cwm-footer-sms-wrap">
    <SmsOptIn variant="footer" />
  </div>

  <div class="cwm-footer-bottom">
    <span>© {new Date().getFullYear()} Car Wash Management LLC. All rights reserved.</span>
  </div>
</footer>
