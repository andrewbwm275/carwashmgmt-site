---
import { PHONE, PHONE_TEL, EMAIL, SOCIAL } from '../../data/site';
import SmsOptIn from './SmsOptIn.astro';
---

<footer class="cwm-footer">
  <div class="cwm-footer-end">
    <div>
      <p class="cwm-footer-kicker">Next</p>
      <h2>Walk the tunnel with us.</h2>
      <p class="cwm-footer-lede">
        San Diego shop. Nationwide service. Quotes by size, not slogans.
      </p>
      <a href="/book-a-call" class="cwm-btn-primary">Book a consult</a>
    </div>
    <div class="cwm-footer-meta">
      <p><strong>Car Wash Services LLC</strong><br />d/b/a Car Wash Management</p>
      <p>7776 Trade Street<br />San Diego, CA 92121</p>
      <p>
        <a href={`tel:${PHONE_TEL}`}>{PHONE}</a><br />
        <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
      </p>
      <p class="cwm-footer-social">
        <a href={SOCIAL.instagram} rel="noopener" target="_blank">Instagram</a>
        <a href={SOCIAL.linkedin} rel="noopener" target="_blank">LinkedIn</a>
        <a href={SOCIAL.youtube} rel="noopener" target="_blank">YouTube</a>
      </p>
    </div>
  </div>

  <SmsOptIn variant="full" />

  <div class="cwm-footer-bottom">
    <nav>
      <a href="/chemistry">Chemistry</a>
      <a href="/about">Story</a>
      <a href="/sms">SMS</a>
      <a href="https://legal.carwashmgmt.com/privacy-policy.html">Privacy</a>
      <a href="https://legal.carwashmgmt.com/terms-and-conditions.html">Terms</a>
    </nav>
    <span>© {new Date().getFullYear()} Car Wash Management</span>
  </div>
</footer>
