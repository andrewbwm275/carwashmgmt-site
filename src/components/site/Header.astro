---
interface Props {
  current?: string;
}
const { current = '' } = Astro.props;

const links = [
  { href: '/chemistry', label: 'Chemistry', key: 'chemistry' },
  { href: '/equipment', label: 'Equipment', key: 'equipment' },
  { href: '/about', label: 'Story', key: 'about' },
  { href: '/contact', label: 'Contact', key: 'contact' },
];
---

<header class="cwm-header" data-site-header>
  <div class="cwm-header-inner">
    <a href="/" class="cwm-logo">Car Wash <em>Management</em></a>
    <nav class="cwm-nav" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} class:list={['cwm-nav-link', current === l.key && 'is-active']}>
          {l.label}
        </a>
      ))}
    </nav>
    <div class="cwm-header-actions">
      <a href="/book-a-call" class="cwm-nav-cta">Consult</a>
      <button type="button" class="cwm-mobile-toggle" data-mobile-toggle aria-label="Open menu">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div id="cwm-mobile-nav" hidden>
  <button type="button" data-mobile-close aria-label="Close menu">Close</button>
  <nav>
    <a href="/">Home</a>
    <a href="/chemistry">Chemistry</a>
    <a href="/equipment">Equipment</a>
    <a href="/preventive-maintenance">Maintenance</a>
    <a href="/about">Story</a>
    <a href="/contact">Contact</a>
    <a href="/sms">SMS program</a>
    <a href="/book-a-call" class="cwm-nav-cta">Book a consult</a>
  </nav>
</div>
