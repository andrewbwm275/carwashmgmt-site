---
const line = [
  { k: 'Presoak', v: 'High, low, and neutral pH' },
  { k: 'Tri-foam', v: 'Blue, green, red, yellow, white' },
  { k: 'Wheel & tire', v: 'Acid, non-acid, solvent and water shine' },
  { k: 'Protect', v: 'Sealant, ceramic, carnauba, graphene' },
];
---

<section class="cwm-index">
  <div class="cwm-index-head">
    <p class="cwm-mono">02 — Line card</p>
    <h2>Honest products.<br />No invented reviews.</h2>
    <p>
      Names from the live catalog. This site does not publish fake testimonials or customer logos.
    </p>
  </div>
  <ol class="cwm-index-list">
    {line.map((c) => (
      <li>
        <small>{c.k}</small>
        <strong>{c.v}</strong>
      </li>
    ))}
  </ol>
  <p class="cwm-index-cta"><a href="/chemistry">Open the catalog</a></p>
</section>
