---
const line = [
  { k: 'Presoak', v: 'High / low / neutral pH' },
  { k: 'Tri-foam', v: 'Blue, green, red, yellow, white' },
  { k: 'Wheel & tire', v: 'Acid & non-acid + tire shine' },
  { k: 'Protectants', v: 'Ceramic, graphene, carnauba, sealant' },
];
---

<section class="cwm-home-section cwm-home-section--ink">
  <div class="cwm-home-wrap">
    <div class="cwm-home-head">
      <p class="cwm-eyebrow">Line card</p>
      <h2 class="cwm-h2">Honest products. No invented reviews.</h2>
      <p class="cwm-lead">
        Names below are from the live catalog. This page does not invent testimonials. If you run a
        CWM site and want to be quoted, <a href="/submit-testimonial" style="color:var(--cwm-brass-hot);text-decoration:underline">send a real one</a>.
      </p>
    </div>
    <div class="cwm-chem-grid">
      {line.map((c) => (
        <div class="cwm-chem">
          <small>{c.k}</small>
          <strong>{c.v}</strong>
        </div>
      ))}
    </div>
  </div>
</section>
