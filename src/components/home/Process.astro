---
const steps = [
  {
    title: 'Walk the site',
    desc: 'We review water, injectors, and how the tunnel actually runs — no obligation.',
  },
  {
    title: 'Plan the chemistry and PM',
    desc: 'A clear plan for dilution, equipment, and a cadence that holds cost-per-car.',
  },
  {
    title: 'Stay on the line',
    desc: 'Implementation and ongoing support so the Saturday rush does not find the failure first.',
  },
];
---

<section class="cwm-home-section cwm-home-section--alt">
  <div class="cwm-home-wrap">
    <div class="cwm-home-head">
      <p class="cwm-eyebrow">How it works</p>
      <h2 class="cwm-h2">From first call to a tunnel that holds.</h2>
      <p class="cwm-lead">Straightforward. Field-first. No boardroom theater.</p>
    </div>
    <div class="cwm-cards cwm-cards-3">
      {steps.map((s, i) => (
        <div class="cwm-card">
          <span class="cwm-step-num">{String(i + 1).padStart(2, '0')}</span>
          <h3>{s.title}</h3>
          <p>{s.desc}</p>
        </div>
      ))}
    </div>
    <div class="cwm-center">
      <a href="/book-a-call" class="cwm-btn-primary cwm-btn-lg">Start a consult</a>
    </div>
  </div>
</section>
