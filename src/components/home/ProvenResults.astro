---
const stats = [
  { value: '15+', label: 'Years in the field — detailing, military wash contracts, then chemistry and PM.' },
  { value: '23', label: 'Catalog products on this site, from presoaks to protectants.' },
  { value: 'SD', label: '7776 Trade Street, San Diego. Nationwide service.' },
  { value: '808', label: 'Voice line 808-465-2291. SMS is keyword-only on this site.' },
];
---

<section class="cwm-home-stats" aria-label="Field facts">
  <div class="cwm-home-stats-inner">
    <div class="cwm-home-stats-grid">
      {stats.map((s) => (
        <div class="cwm-home-stat">
          <b>{s.value}</b>
          <span>{s.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
