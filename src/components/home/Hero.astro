---
import { HERO_HOME } from '../../data/site';
---

<section class="cwm-hero">
  <div class="cwm-hero-grid">
    <div class="cwm-hero-copy">
      <p class="cwm-eyebrow">San Diego · chemistry · PM</p>
      <h1 class="cwm-h1">The wash, run like a plant.</h1>
      <p class="cwm-lead">
        Car Wash Management is an operator shop: tunnel chemistry, equipment, and preventive
        maintenance for owners who already know the difference between a pretty foam show and a
        cost-per-car that holds.
      </p>
      <div class="cwm-hero-pills">
        <span class="cwm-pill">15+ years in the field</span>
        <span class="cwm-pill">Chemistry matched to the water</span>
        <span class="cwm-pill">PM before Saturday dies</span>
      </div>
      <div class="cwm-hero-actions">
        <a href="/book-a-call" class="cwm-btn-primary cwm-btn-lg">Book a free consult</a>
        <a href="/chemistry" class="cwm-btn-secondary cwm-btn-lg">See the chemistry line</a>
      </div>
      <p class="cwm-hero-note">7776 Trade Street · nationwide service · voice 808-465-2291</p>
    </div>
    <div class="cwm-hero-media">
      <img src={HERO_HOME} alt="Car wash tunnel" width="800" height="600" />
    </div>
  </div>
</section>
