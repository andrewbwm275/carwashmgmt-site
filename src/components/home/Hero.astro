---
import { HERO_HOME } from '../../data/site';
---

<section class="cwm-hero">
  <div class="cwm-hero-grid">
    <div>
      <h1 class="cwm-h1">Turn Your Car Wash Into a Profit Machine</h1>
      <p class="cwm-lead" style="max-width:36rem">
        We help car wash owners cut chemical waste, eliminate unplanned downtime, and increase per-car profit—with systems built from 15+ years in the field.
      </p>
      <div class="cwm-hero-pills">
        <span class="cwm-pill">• 20-40% lower chemical costs</span>
        <span class="cwm-pill">• 70% less unplanned downtime</span>
        <span class="cwm-pill">• Faster throughput &amp; better margins</span>
      </div>
      <div class="cwm-hero-actions">
        <a href="/book-a-call" class="cwm-btn-primary cwm-btn-lg">
          Improve My Wash Performance
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a href="/calculator" class="cwm-btn-secondary cwm-btn-lg">
          Calculate My Savings
        </a>
      </div>
      <p class="cwm-hero-note">Limited availability each week • No obligation • No pressure</p>
    </div>
    <div class="cwm-hero-media">
      <img
        src={HERO_HOME}
        alt="Car wash performance systems"
        width="800"
        height="600"
      />
    </div>
  </div>
</section>
