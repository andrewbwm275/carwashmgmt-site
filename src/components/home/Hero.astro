---
import { HERO_HOME } from '../../data/site';
---

<section class="cwm-hero">
  <div class="cwm-hero-photo">
    <img src={HERO_HOME} alt="Express tunnel at work" width="1600" height="1000" />
  </div>
  <div class="cwm-hero-veil"></div>
  <div class="cwm-hero-copy">
    <p class="cwm-mono">San Diego · Trade Street</p>
    <h1>The wash,<br /><em>run like a plant.</em></h1>
    <p class="cwm-hero-lede">
      Tunnel chemistry, equipment, and preventive maintenance for owners who already know the
      difference between a foam show and a cost-per-car that holds.
    </p>
    <div class="cwm-hero-actions">
      <a href="/chemistry" class="cwm-btn-primary">The chemistry line</a>
      <a href="/book-a-call" class="cwm-btn-ghost">Book a consult</a>
    </div>
  </div>
</section>
